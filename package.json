{
  "name": "1sat-sdk",
  "private": true,
  "workspaces": [
    "packages/*",
    "examples/*",
    "test-app"
  ],
  "scripts": {
    "build": "bun run --filter '*' build",
    "dev": "bun run --filter '*' dev",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "clean": "rm -rf packages/*/dist",
    "test": "bun test",
    "gen:action-index": "bun run scripts/gen-action-index.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@types/bun": "^1.3.10",
    "dotenv": "^17.3.1",
    "sqlite3": "^6.0.1",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@ai-sdk/mcp": "^1.0.30",
    "@bopen-io/messagebox-server": "^1.3.2"
  },
  "overrides": {
    "@bsv/sdk": "^4.0.0",
    "@bsv/templates": "^2.1.0",
    "@bsv/wallet-toolbox": "^2.15.0",
    "@bsv/wallet-toolbox-client": "^2.15.0",
    "@bsv/color-permission-module": "^0.1.0"
  }
}
