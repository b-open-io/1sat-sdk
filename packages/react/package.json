{
	"name": "@1sat/react",
	"version": "0.0.11",
	"description": "React hooks and components for 1Sat wallet integration",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "bun run build.ts && tsc --emitDeclarationOnly",
		"dev": "tsc --watch"
