{
  "name": "@1sat/wallet-browser",
  "version": "0.0.10",
  "description": "Browser wallet factory for 1Sat Ordinals SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
