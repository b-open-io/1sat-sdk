  },
  "peerDependencies": {
    "@1sat/client": "^0.0.6",
    "@bsv/sdk": "^2.0.1",
    "@bsv/wallet-toolbox-mobile": "npm:@bopen-io/wallet-toolbox-mobile@2.0.5-idb-fix.2"
  },
  "devDependencies": {
    "@bsv/sdk": "^2.0.1",
    "@bsv/wallet-toolbox-mobile": "npm:@bopen-io/wallet-toolbox-mobile@2.0.5-idb-fix.2",
    "typescript": "^5.9.3"
  }
