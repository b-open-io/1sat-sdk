{
  "name": "@1sat/wallet-browser",
  "version": "0.0.89",
  "description": "Browser wallet factory for 1Sat Ordinals SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "1sat",
    "bsv",
    "ordinals",
    "wallet",
    "browser"
  ],
  "license": "MIT",
  "dependencies": {
    "@1sat/wallet": "workspace:*"
  },
  "peerDependencies": {
    "@1sat/client": "workspace:*",
    "@bsv/sdk": "^2.1.9",
    "@bsv/wallet-toolbox-client": "npm:@bopen-io/wallet-toolbox-client@2.6.2-brc153.5"
  },
  "devDependencies": {
    "@bsv/sdk": "^2.1.9",
    "@bsv/wallet-toolbox-client": "npm:@bopen-io/wallet-toolbox-client@2.6.2-brc153.5",
    "typescript": "^5.9.3"
  }
}
