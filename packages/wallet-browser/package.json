{
	"name": "@1sat/wallet-browser",
	"version": "0.0.2",
	"description": "Browser wallet factory for 1Sat Ordinals SDK",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"clean": "rm -rf dist"
	},
	"keywords": ["1sat", "bsv", "ordinals", "wallet", "browser"],
	"license": "MIT",
	"dependencies": {
		"@1sat/client": "workspace:*",
		"@1sat/wallet": "workspace:*"
	},
	"peerDependencies": {
		"@bsv/sdk": "^2.0.1",
		"@bsv/wallet-toolbox-mobile": "^2.0.4"
	},
	"devDependencies": {
		"@bsv/sdk": "^2.0.1",
		"@bsv/wallet-toolbox-mobile": "^2.0.4",
		"typescript": "^5.9.3"
	}
}
