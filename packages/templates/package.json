{
	"name": "@1sat/templates",
	"version": "0.0.2",
	"description": "Bitcoin script templates for 1Sat Ordinals SDK",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./sigma": {
			"types": "./dist/bitcom/sigma.d.ts",
			"import": "./dist/bitcom/sigma.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"clean": "rm -rf dist"
	},
	"keywords": ["1sat", "bsv", "ordinals", "templates", "typescript"],
	"license": "MIT",
	"dependencies": {
		"@1sat/types": "workspace:*"
	},
	"peerDependencies": {
		"@bsv/sdk": "^2.0.6",
		"sigma-protocol": "^0.1.9"
	},
	"peerDependenciesMeta": {
		"sigma-protocol": { "optional": true }
	},
	"devDependencies": {
		"@bsv/sdk": "^2.0.6",
		"sigma-protocol": "^0.1.9",
		"typescript": "^5.9.3"
	}
}
