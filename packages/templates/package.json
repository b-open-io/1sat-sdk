{
	"name": "@1sat/templates",
	"version": "0.0.8",
	"description": "Bitcoin script templates for 1Sat Ordinals SDK",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"bun": "./src/index.ts",
			"import": "./dist/index.js"
		},
		"./sigma": {
			"types": "./dist/bitcom/sigma.d.ts",
			"bun": "./src/bitcom/sigma.ts",
			"import": "./dist/bitcom/sigma.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"clean": "rm -rf dist"
	},
	"keywords": [
		"1sat",
		"bsv",
		"ordinals",
		"templates",
		"typescript"
	],
	"license": "MIT",
	"dependencies": {
		"@1sat/types": "workspace:*"
	},
	"peerDependencies": {
		"@bsv/sdk": "^2.0.13"
	},
	"devDependencies": {
		"@bsv/sdk": "^2.0.13",
		"typescript": "^5.9.3"
	}
}
