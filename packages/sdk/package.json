{
	"name": "@1sat/sdk",
	"version": "0.0.4",
	"description": "1Sat Ordinals SDK - Complete toolkit for BSV ordinals, tokens, and wallet integration",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./connect": {
			"types": "./dist/connect.d.ts",
			"import": "./dist/connect.js"
		},
		"./core": {
			"types": "./dist/core.d.ts",
			"import": "./dist/core.js"
		},
		"./client": {
			"types": "./dist/client.d.ts",
			"import": "./dist/client.js"
		},
		"./protocols": {
			"types": "./dist/protocols.d.ts",
			"import": "./dist/protocols.js"
		},
		"./wallet": {
			"types": "./dist/wallet.d.ts",
			"import": "./dist/wallet.js"
		},
		"./wallet-browser": {
			"types": "./dist/wallet-browser.d.ts",
			"import": "./dist/wallet-browser.js"
		},
		"./wallet-node": {
			"types": "./dist/wallet-node.d.ts",
			"import": "./dist/wallet-node.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch"
	},
	"keywords": ["1sat", "bsv", "ordinals", "wallet", "sdk", "bitcoin"],
	"license": "MIT",
	"dependencies": {
		"@1sat/actions": "workspace:*",
		"@1sat/connect": "workspace:*",
		"@1sat/types": "workspace:*",
		"@1sat/utils": "workspace:*",
		"@1sat/client": "workspace:*",
		"@1sat/core": "workspace:*",
		"@1sat/wallet": "workspace:*",
		"@1sat/wallet-browser": "workspace:*",
		"@1sat/wallet-node": "workspace:*"
	},
	"peerDependencies": {
		"@bsv/sdk": "^2.0.1"
	},
	"devDependencies": {
		"@bsv/sdk": "^2.0.1",
		"typescript": "^5.9.3"
	}
}
