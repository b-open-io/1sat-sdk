{
	"name": "@1sat/wallet-mac",
	"version": "0.0.3",
	"description": "macOS wallet runtime with Secure Enclave and native UI",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"bun": "./src/index.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist",
		"swift/Sources/main.swift",
		"swift/build.sh"
	],
	"scripts": {
		"build": "tsc",
		"build:swift": "./swift/build.sh",
		"postinstall": "./swift/build.sh",
		"dev": "tsc --watch",
		"clean": "rm -rf dist"
	},
	"license": "MIT",
	"dependencies": {
		"@1sat/vault": "workspace:*"
	},
	"peerDependencies": {
		"@bsv/sdk": "^2.0.13"
	},
	"devDependencies": {
		"@bsv/sdk": "^2.0.13",
		"typescript": "^5.9.3"
	}
}
