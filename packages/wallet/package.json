{
	"name": "@1sat/wallet",
	"version": "0.0.5",
	"description": "BRC-100 wallet engine for 1Sat Ordinals SDK",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./browser": {
			"types": "./dist/browser.d.ts",
			"import": "./dist/browser.js"
		},
		"./node": {
			"types": "./dist/node.d.ts",
			"import": "./dist/node.js"
		}
	},
	"files": ["dist"],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"clean": "rm -rf dist"
	},
	"keywords": ["1sat", "bsv", "ordinals", "wallet", "brc-100"],
	"license": "MIT",
	"dependencies": {
		"@1sat/client": "^0.0.2",
		"@1sat/types": "^0.0.2",
		"@1sat/constants": "^0.0.2",
		"@bopen-io/templates": "^1.1.7",
		"@msgpack/msgpack": "^3.1.3",
		"fflate": "^0.8.2"
	},
	"peerDependencies": {
		"@bsv/sdk": "^1.10.4",
		"@bsv/wallet-toolbox": "npm:@bopen-io/wallet-toolbox@1.7.24-idb-fix.1",
		"@bsv/wallet-toolbox-mobile": "npm:@bopen-io/wallet-toolbox-mobile@1.7.24-idb-fix.1",
		"knex": "^3.0.0"
	},
	"peerDependenciesMeta": {
		"knex": {
			"optional": true
		},
		"@bsv/wallet-toolbox-mobile": {
			"optional": true
		}
	},
	"devDependencies": {
		"@bsv/sdk": "^1.10.4",
		"@bsv/wallet-toolbox": "npm:@bopen-io/wallet-toolbox@1.7.24-idb-fix.1",
		"@bsv/wallet-toolbox-mobile": "npm:@bopen-io/wallet-toolbox-mobile@1.7.24-idb-fix.1",
		"@types/chrome": "^0.1.32",
		"typescript": "^5.9.3"
	}
}
