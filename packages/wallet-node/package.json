{
  "name": "@1sat/wallet-node",
  "version": "0.0.30",
  "description": "Node/Bun wallet factory for 1Sat Ordinals SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "bun": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist"
  },
  "keywords": [
    "1sat",
    "bsv",
    "ordinals",
    "wallet",
    "node",
    "server",
    "cli"
  ],
  "license": "MIT",
  "dependencies": {
    "@1sat/wallet": "workspace:*"
  },
  "peerDependencies": {
    "@bsv/sdk": "^2.0.13",
    "@bsv/wallet-toolbox": "^2.1.21",
    "knex": "^3.1.0",
    "pg": "^8.11.0"
  },
  "peerDependenciesMeta": {
    "better-sqlite3": {
      "optional": true
    },
    "knex": {
      "optional": true
    },
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@1sat/client": "workspace:*",
    "@bsv/sdk": "^2.0.13",
    "@bsv/wallet-toolbox": "^2.1.21",
    "@types/pg": "^8.11.0",
    "knex": "^3.1.0",
    "pg": "^8.11.0",
    "typescript": "^5.9.3"
  }
}
