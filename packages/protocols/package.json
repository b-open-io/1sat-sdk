	"license": "MIT",
	"dependencies": {
		"@1sat/types": "workspace:*",
		"@1sat/constants": "workspace:*",
		"@1sat/utils": "workspace:*",
		"sigma-protocol": "^0.1.6"
	},
	"peerDependencies": {
		"@bsv/sdk": "^1.9.0"
	},
	"devDependencies": {
		"@bsv/sdk": "^1.9.24",
		"typescript": "^5.9.3"
	}
