{
	"name": "@1sat/knex-bun-sqlite",
	"version": "0.0.2",
	"description": "Knex dialect backed by Bun's built-in bun:sqlite",
	"type": "module",
	"main": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		}
	},
	"files": [
		"dist"
	],
	"scripts": {
		"build": "tsc",
		"dev": "tsc --watch",
		"clean": "rm -rf dist",
		"test": "bun test"
	},
	"keywords": [
		"knex",
		"sqlite",
		"bun"
	],
	"license": "MIT",
	"engines": {
		"bun": ">=1.0.0"
	},
	"peerDependencies": {
		"knex": "^3.0.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.10",
		"knex": "^3.2.9",
		"typescript": "^5.9.3"
	}
}
