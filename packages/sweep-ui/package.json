{
	"name": "@1sat/sweep-ui",
	"version": "0.0.71",
	"description": "Sweep UI components for migrating legacy BSV assets",
	"type": "module",
	"main": "./src/index.ts",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./src/index.ts"
		}
	},
	"files": [
		"dist",
		"src"
	],
	"scripts": {
		"build": "bun run build.ts && tsc --emitDeclarationOnly",
		"dev": "tsc --watch"
	},
	"keywords": [
		"1sat",
		"bsv",
		"ordinals",
		"sweep",
		"migration",
		"react"
	],
	"license": "MIT",
	"dependencies": {
		"@1sat/actions": "workspace:*",
		"@1sat/client": "workspace:*",
		"@1sat/connect": "workspace:*",
		"@1sat/types": "workspace:*",
		"@1sat/utils": "workspace:*",
		"bitcoin-backup": "^0.0.11",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"lucide-react": "^0.577.0",
		"sonner": "^2.0.7",
		"tailwind-merge": "^3.5.0"
	},
	"peerDependencies": {
		"@bsv/sdk": "^2.0.13",
		"react": "^18.0.0 || ^19.0.0"
	},
	"devDependencies": {
		"@bsv/sdk": "^2.0.13",
		"@types/react": "^19.0.0",
		"react": "^19.0.0",
		"typescript": "~5.7.0"
	}
}
