  },
  "peerDependencies": {
    "@bsv/auth-express-middleware": "^2.0.4",
    "@bsv/sdk": "^2.0.13",
    "@bsv/wallet-toolbox": "npm:@bopen-io/wallet-toolbox@2.1.21-parity-fix.2",
    "knex": "^3.1.0"
  },
  "peerDependenciesMeta": {
    "pg": {
      "optional": true
    }
  },
  "devDependencies": {
    "@bsv/auth-express-middleware": "^2.0.4",
    "@bsv/sdk": "^2.0.13",
    "@bsv/wallet-toolbox": "npm:@bopen-io/wallet-toolbox@2.1.21-parity-fix.2",
    "@types/bun": "^1.3.10",
    "@types/express": "^4.17.21",
    "knex": "^3.1.0",
    "typescript": "^5.9.3"
  }
