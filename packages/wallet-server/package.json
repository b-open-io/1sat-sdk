{
  "name": "@1sat/wallet-server",
  "version": "0.0.18",
  "description": "BRC-100 wallet storage RPC server for 1Sat Ordinals SDK",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "test": "bun test"
  },
  "keywords": [
    "1sat",
    "bsv",
    "ordinals",
    "wallet",
    "server",
    "rpc",
    "brc-100"
  ],
  "license": "MIT",
  "dependencies": {
    "@1sat/client": "workspace:*",
    "@1sat/wallet": "workspace:*",
    "evlog": "^2.13.0",
