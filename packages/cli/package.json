{
	"name": "@1sat/cli",
	"version": "0.0.19",
	"description": "CLI for 1Sat Ordinals SDK",
	"type": "module",
	"main": "./src/cli.ts",
	"bin": {
		"1sat": "./src/cli.ts"
	},
	"files": ["src"],
	"scripts": {
		"build": "bun build ./src/cli.ts --compile --outfile=bin/1sat --external pg --external pg-native --external pg-query-stream --external tedious --external oracledb --external mysql",
		"dev": "bun run src/cli.ts",
		"lint": "biome check src"
	},
	"keywords": ["1sat", "bsv", "ordinals", "cli"],
	"license": "MIT",
	"dependencies": {
		"@1sat/actions": "workspace:*",
		"@1sat/client": "workspace:*",
		"@1sat/types": "workspace:*",
		"@1sat/wallet-node": ">=0.0.13",
		"@bsv/sdk": "^2.0.6",
		"chalk": "^5.0.0",
		"@clack/prompts": "^0.8.0",
		"bitcoin-backup": "^0.0.11",
		"dotenv": "^17.0.0",
		"evlog": "^2.10.0"
	},
	"devDependencies": {
		"@types/bun": "^1.3.9",
		"typescript": "^5.9.3"
	}
}
